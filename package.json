{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "package:build": "node scripts/sync-package.mjs && tsc -p packages/retro-ui/tsconfig.json",
    "registry:build": "node scripts/build-registry.mjs",
    "elements:build": "tsc -p packages/retro-elements/tsconfig.json",
    "packages:build": "pnpm package:build && pnpm elements:build",
    "packages:check": "pnpm packages:build && pnpm -r --filter \"./packages/*\" exec npm pack --dry-run",
    "packages:publish": "pnpm packages:build && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/analytics": "2.0.1",
    "@your-scope/retrokit-elements": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.82.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "just-bash": "^3.6.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
