      "--color-rt-accent-hi": "#6bff9e",
      "--color-rt-accent-press": "#1fc95b",
      "--color-rt-on-accent": "#03120a",
      "--color-rt-desktop": "#020a04",
      "--color-rt-desktop-ink": "#4dff88",
