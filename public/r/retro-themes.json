      "--color-rt-danger": "#f06060",
      "--color-mac-paper": "#171a21",
      "--color-mac-ink": "#e6e8ee",
      "--color-mac-hover": "#2b2f3a",
      "--color-mac-dim": "#8c93a3"
    },
    "[data-rt-font='plex']": {
      "--font-rt": "var(--font-plex-sans, 'IBM Plex Sans'), ui-sans-serif, system-ui, sans-serif",
      "--font-rt-mono": "var(--font-plex-mono, 'IBM Plex Mono'), ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "[data-rt-font='pixel']": {
      "--font-rt": "var(--font-vt323, 'VT323'), ui-monospace, monospace",
      "--font-rt-mono": "var(--font-press-start, 'Press Start 2P'), ui-monospace, monospace",
      "font-size-adjust": "0.46"
    },
    "[data-rt-font='system']": {
      "--font-rt": "Chicago, Charcoal, Geneva, 'MS Sans Serif', Tahoma, Verdana, ui-sans-serif, system-ui, sans-serif",
      "--font-rt-mono": "Monaco, 'SF Mono', Menlo, Consolas, ui-monospace, monospace"
    },
    "[data-rt-font='mono']": {
      "--font-rt": "var(--font-plex-mono, 'IBM Plex Mono'), ui-monospace, SFMono-Regular, Menlo, monospace",
      "--font-rt-mono": "var(--font-plex-mono, 'IBM Plex Mono'), ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "meta": {
    "author": "Poliedro69 (https://machinetix.com)",
