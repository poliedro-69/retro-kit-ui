    "[data-rt-theme='dark']": {
      "color-scheme": "dark",
      "--color-rt-face": "#2b2f3a",
      "--color-rt-face-hi": "#363b48",
      "--color-rt-light": "#4a5163",
      "--color-rt-shadow": "#14161d",
      "--color-rt-line": "#0b0c10",
