{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "retro-themes",
  "title": "RetroKit themes",
  "description": "Six color themes (Classic Navy, Hot Dog Stand, Phosphor Green, Amber Terminal, Rose, Dark) and four font themes (IBM Plex, Pixel, System, Mono). Set data-rt-theme and data-rt-font on any element, or use <RetroTheme>.",
  "registryDependencies": [
    "https://machinetix.com/r/retro-ui.json"
  ],
  "css": {
    "[data-rt-theme='navy']": {
      "color-scheme": "light",
      "--color-rt-face": "#dde0e6",
      "--color-rt-face-hi": "#eceef2",
      "--color-rt-light": "#ffffff",
      "--color-rt-shadow": "#8c93a3",
      "--color-rt-line": "#20242f",
      "--color-rt-ink": "#1b1f2a",
      "--color-rt-paper": "#ffffff",
      "--color-rt-pressed": "#cdd1d9",
      "--color-rt-accent": "#2b49c9",
      "--color-rt-accent-deep": "#162a82",
      "--color-rt-accent-hi": "#4663e0",
      "--color-rt-accent-press": "#1f3aa8",
      "--color-rt-on-accent": "#ffffff",
      "--color-rt-desktop": "#167a84",
      "--color-rt-desktop-ink": "#ffffff",
      "--color-rt-warn": "#f5c542",
      "--color-rt-ok": "#2f9e5b",
      "--color-rt-danger": "#d64545",
      "--color-mac-paper": "#ffffff",
      "--color-mac-ink": "#000000",
      "--color-mac-hover": "#f5f5f5",
      "--color-mac-dim": "#737373"
    },
    "[data-rt-theme='hotdog']": {
